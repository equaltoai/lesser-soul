{
  "name": "@equaltoai/lesser-soul-site",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:site": "tsx site/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "synth": "npm run build:site && cdk synth -c stage=${STAGE:-lab}",
    "deploy": "npm run build:site && cdk deploy --all",
    "destroy": "cdk destroy --all",
    "check:contracts": "node scripts/check-panonomous-contracts.mjs"
  },
  "dependencies": {
    "@theory-cloud/facetheory": "https://github.com/theory-cloud/FaceTheory/releases/download/v5.0.0/theory-cloud-facetheory-5.0.0.tgz",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "aws-cdk": "2.1145.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
