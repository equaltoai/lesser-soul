{
  "name": "@equaltoai/lesser-soul-site",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:site": "tsx site/build.ts",
    "refresh:aws-cdk-lib-patch": "bash ./scripts/build-patched-aws-cdk-lib.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "synth": "npm run build:site && cdk synth -c stage=${STAGE:-lab}",
    "deploy": "npm run build:site && cdk deploy --all",
    "destroy": "cdk destroy --all",
    "check:contracts": "node scripts/check-panonomous-contracts.mjs"
  },
  "dependencies": {
    "@theory-cloud/facetheory": "https://github.com/theory-cloud/FaceTheory/releases/download/v4.0.1/theory-cloud-facetheory-4.0.1.tgz",
    "aws-cdk-lib": "2.260.0",
    "constructs": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "aws-cdk": "2.1130.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
